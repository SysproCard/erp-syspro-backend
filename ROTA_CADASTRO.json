// =========================================================================
// LEGENDA DOS CAMPOS
// =========================================================================

CAMPOS OBRIGATÓRIOS:
  - nome: string (máximo 100 caracteres)
  - email: string (formato válido com @)
  - senha: string (máximo 255 caracteres)

CAMPOS OPCIONAIS:
  - codigo: string (identificador único do usuário, máximo 50 caracteres)
  - nivel: número inteiro (1-5, padrão: 1)
  - bloqueado: booleano (true/false, padrão: false)
  
PERMISSÕES (todas booleanas, padrão: false):
  - alteraPercentualPrestador: permite alterar percentual de prestador
  - alteraLimiteUsuarios: permite alterar limite dos usuários
  - efetuaCancelamentoBaixa: permite efetuar cancelamento de baixa
  - permiteExclusaoTransacoes: permite exclusão de transações
  - permiteAlteracaoSituacao: permite alteração de situação/limite de alimentação
  - permiteEscolherLocalBaixa: permite escolher local de baixa

// =========================================================================
// COMO TESTAR COM CURL (Terminal)
// =========================================================================

curl -X POST http://localhost:3000/auth/cadastro \
  -H "Content-Type: application/json" \
  -d '{
    "codigo": "USR001",
    "nome": "João Silva",
    "email": "joao.silva@empresa.com",
    "senha": "senha123",
    "nivel": 2,
    "bloqueado": false,
    "alteraPercentualPrestador": true,
    "alteraLimiteUsuarios": true,
    "efetuaCancelamentoBaixa": false,
    "permiteExclusaoTransacoes": false,
    "permiteAlteracaoSituacao": true,
    "permiteEscolherLocalBaixa": false
  }'

// =========================================================================
// COMO TESTAR COM JAVASCRIPT/FETCH
// =========================================================================

fetch('http://localhost:3000/auth/cadastro', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json'
  },
  body: JSON.stringify({
    codigo: "USR001",
    nome: "João Silva",
    email: "joao.silva@empresa.com",
    senha: "senha123",
    nivel: 2,
    bloqueado: false,
    alteraPercentualPrestador: true,
    alteraLimiteUsuarios: true,
    efetuaCancelamentoBaixa: false,
    permiteExclusaoTransacoes: false,
    permiteAlteracaoSituacao: true,
    permiteEscolherLocalBaixa: false
  })
})
.then(response => response.json())
.then(data => console.log(data))
.catch(error => console.error('Erro:', error));
